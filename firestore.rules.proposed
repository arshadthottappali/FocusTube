// PROPOSAL ONLY. Compare with current deployed rules and other project consumers.
// Deploying this blocks existing shared-course links as well as old clients.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /shared_courses/{courseId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
